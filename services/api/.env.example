# Copy to .env and fill in real values. Never commit .env.
ENVIRONMENT=development
DEBUG=false

DATABASE_URL=postgresql+psycopg://career:career@localhost:5434/career_assistant

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=10080

CORS_ORIGINS=["http://localhost:3000"]

# AI provider: "gemini" (default) or "fake" (deterministic stub used by tests)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
